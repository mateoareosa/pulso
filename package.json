{
  "name": "pulso-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @pulso/api test:integration",
    "test:e2e": "pnpm --filter @pulso/web test:e2e",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "prisma": "pnpm --filter @pulso/api exec prisma",
    "db:test:prepare": "node scripts/prepare-test-db.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
