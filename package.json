{
  "name": "pulso-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "prettier --check \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
