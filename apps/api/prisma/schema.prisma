datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MembershipActionType {
  INVITE
  PASSWORD_RESET
}

enum EmployeeAuditAction {
  INVITED
  ROLE_STATUS_ASSIGNMENTS_CHANGED
  PASSWORD_RESET_ISSUED
  SESSIONS_REVOKED
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COUNT_CORRECTION
  SALE
  PURCHASE
  RETURN
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  CASH_IN
  CASH_OUT
  CLOSING
  REFUND
}

enum SaleAdjustmentType {
  RETURN
  VOID
}

enum SaleAdjustmentStatus {
  COMPLETED
  PENDING
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum PurchasePaymentSource {
  CASH_REGISTER
  OUTSIDE_CASH
  UNSPECIFIED
}

enum ProductImportResult {
  SUCCESS
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  email              String
  normalizedEmail    String              @unique
  name               String
  passwordHash        String?
  credentialVersion   Int                     @default(1)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        TenantMembership[]
  sessions           Session[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  openedShifts       CashShift[]         @relation("ShiftOpenedBy")
  closedShifts       CashShift[]         @relation("ShiftClosedBy")
  cashMovements      CashMovement[]
  createdPurchases    Purchase[]              @relation("PurchaseCreatedBy")
  receivedPurchases   Purchase[]              @relation("PurchaseReceivedBy")
  cancelledPurchases  Purchase[]              @relation("PurchaseCancelledBy")
  actionTokens        MembershipActionToken[] @relation("ActionTokenUser")
  createdActionTokens MembershipActionToken[] @relation("ActionTokenCreator")
  employeeAuditEvents EmployeeAuditEvent[]    @relation("EmployeeAuditActor")
  saleAdjustments     SaleAdjustment[]        @relation("SaleAdjustmentActor")
  productImportAudits ProductImportAudit[]    @relation("ProductImportActor")

  @@map("users")
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  locations          Location[]
  memberships        TenantMembership[]
  sessions           Session[]
  categories         Category[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]
  suppliers              Supplier[]
  purchases              Purchase[]
  membershipActionTokens MembershipActionToken[]
  employeeAuditEvents    EmployeeAuditEvent[]
  saleAdjustments        SaleAdjustment[]
  productImportAudits    ProductImportAudit[]

  @@map("tenants")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  version       Int              @default(1)
  accessVersion Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations    MembershipLocation[]
  sessions     Session[]               @relation("SessionMembership")
  actionTokens MembershipActionToken[] @relation("ActionTokenMembership")
  auditEvents  EmployeeAuditEvent[]    @relation("EmployeeAuditTarget")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@unique([tenantId, userId, id])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Location {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  address            String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions            Session[]            @relation("SessionLocation")
  productLocations   ProductLocation[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]
  purchases           Purchase[]
  membershipLocations MembershipLocation[] @relation("MembershipLocationLocation")
  saleAdjustments     SaleAdjustment[]
  productImportAudits ProductImportAudit[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("locations")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  membershipId            String
  locationId String
  credentialVersion       Int
  membershipAccessVersion Int
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation("SessionMembership", fields: [tenantId, userId, membershipId], references: [tenantId, userId, id], onDelete: Cascade)
  location   Location         @relation("SessionLocation", fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, membershipId])
  @@index([tokenHash])
  @@map("sessions")
}

model MembershipLocation {
  id           String   @id @default(cuid())
  tenantId     String
  membershipId String
  locationId   String
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location   Location         @relation("MembershipLocationLocation", fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([membershipId, locationId])
  @@index([tenantId, locationId])
  @@map("membership_locations")
}

model MembershipActionToken {
  id              String               @id @default(cuid())
  tenantId        String
  userId          String
  membershipId    String
  type            MembershipActionType
  tokenHash       String               @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation("ActionTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation("ActionTokenMembership", fields: [tenantId, userId, membershipId], references: [tenantId, userId, id], onDelete: Cascade)
  createdBy  User             @relation("ActionTokenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, membershipId, type, expiresAt])
  @@index([userId, type])
  @@map("membership_action_tokens")
}

model EmployeeAuditEvent {
  id                 String              @id @default(cuid())
  tenantId           String
  actorUserId        String
  targetMembershipId String
  action             EmployeeAuditAction
  metadata           Json
  createdAt          DateTime            @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor            User             @relation("EmployeeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetMembership TenantMembership @relation("EmployeeAuditTarget", fields: [tenantId, targetMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  @@index([targetMembershipId])
  @@map("employee_audit_events")
}

model Category {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                 String              @id @default(cuid())
  tenantId           String
  categoryId         String?
  name               String
  normalizedName     String
  barcode            String?
  sku                String?
  salePriceCents     Int
  costPriceCents     Int?
  unit               String              @default("UNIT")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locations          ProductLocation[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems       PurchaseItem[]
  saleAdjustmentItems SaleAdjustmentItem[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, normalizedName])
  @@index([categoryId])
  @@map("products")
}

model ProductLocation {
  id            String    @id @default(cuid())
  productId     String
  locationId    String
  stockQuantity Decimal   @default(0) @db.Decimal(12, 4)
  minimumStock  Decimal   @default(0) @db.Decimal(12, 4)
  isAvailable   Boolean   @default(true)
  quickSlot     Int?
  version       Int       @default(1)
  lastCostCents Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@unique([locationId, quickSlot])
  @@index([locationId])
  @@map("product_locations")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  locationId     String
  productId      String
  saleId         String?
  purchaseId       String?
  purchaseItemId   String?
  saleAdjustmentId String?
  type           InventoryMovementType
  delta          Decimal               @db.Decimal(12, 4)
  previousStock  Decimal               @db.Decimal(12, 4)
  resultingStock Decimal               @db.Decimal(12, 4)
  reason         String
  userId         String
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale           Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase         Purchase?             @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleAdjustment   SaleAdjustment?       @relation(fields: [saleAdjustmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, locationId, productId, createdAt])
  @@index([saleId])
  @@index([purchaseId])
  @@index([saleAdjustmentId])
  @@map("inventory_movements")
}

model ProductImportAudit {
  id               String              @id @default(cuid())
  tenantId         String
  locationId       String
  actorUserId      String
  previewTokenHash String
  inputHash        String
  fileName         String
  result           ProductImportResult
  totalRows        Int
  importedCount    Int                 @default(0)
  categoryCount    Int                 @default(0)
  errorCode        String?
  createdAt        DateTime            @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  actor    User     @relation("ProductImportActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, previewTokenHash])
  @@index([tenantId, locationId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("product_import_audits")
}

model Sale {
  id                 String              @id @default(cuid())
  tenantId           String
  locationId         String
  userId             String
  shiftId            String?
  idempotencyKey     String
  totalCents         Int
  status             String              @default("COMPLETED")
  createdAtUtc       DateTime
  persistedAt        DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  tenders            SaleTender[]
  inventoryMovements InventoryMovement[]
  cashMovements      CashMovement[]
  adjustments        SaleAdjustment[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, createdAtUtc])
  @@index([shiftId])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(cuid())
  saleId          String
  productId       String
  name            String
  barcode         String?
  quantity        Decimal  @db.Decimal(12, 4)
  unitPriceCents  Int
  totalPriceCents Int
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  adjustmentItems SaleAdjustmentItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleTender {
  id                  String  @id @default(cuid())
  saleId              String
  type                String
  amountCents         Int
  receivedAmountCents Int?
  changeAmountCents   Int?
  reference           String?
  sale                Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_tenders")
}

model CashShift {
  id                    String            @id @default(cuid())
  tenantId              String
  locationId            String
  openedByUserId        String
  closedByUserId        String?
  status                CashShiftStatus   @default(OPEN)
  openingAmountCents    Int
  expectedAmountCents   Int?
  countedAmountCents    Int?
  differenceAmountCents Int?
  openedAtUtc           DateTime
  closedAtUtc           DateTime?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  openedByUser          User              @relation("ShiftOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedByUser          User?             @relation("ShiftClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements             CashMovement[]
  purchases       Purchase[]
  saleAdjustments SaleAdjustment[]

  @@index([tenantId, locationId, status])
  @@index([tenantId, locationId, openedAtUtc])
  @@map("cash_shifts")
}

model CashMovement {
  id                String            @id @default(cuid())
  tenantId          String
  locationId        String
  shiftId           String
  createdByUserId   String
  type              CashMovementType
  amountCents       Int
  signedAmountCents Int
  reason            String?
  saleId            String?
  purchaseId        String?
  saleAdjustmentId  String?
  idempotencyKey    String
  createdAtUtc      DateTime          @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shift             CashShift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdByUser     User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  sale              Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleAdjustment SaleAdjustment? @relation(fields: [saleAdjustmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, shiftId, createdAtUtc])
  @@index([shiftId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([saleAdjustmentId])
  @@map("cash_movements")
}

model SaleAdjustment {
  id             String               @id @default(cuid())
  tenantId       String
  locationId     String
  saleId         String
  actorUserId    String
  shiftId        String?
  idempotencyKey String
  type           SaleAdjustmentType
  status         SaleAdjustmentStatus @default(COMPLETED)
  reason         String
  totalCents     Int
  refundTender   String               @default("CASH")
  refundStatus   String               @default("COMPLETED")
  createdAt      DateTime             @default(now())

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location           Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sale               Sale                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  actor              User                 @relation("SaleAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  shift              CashShift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  items              SaleAdjustmentItem[]
  inventoryMovements InventoryMovement[]
  cashMovements      CashMovement[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, saleId, createdAt])
  @@map("sale_adjustments")
}

model SaleAdjustmentItem {
  id             String  @id @default(cuid())
  adjustmentId   String
  saleItemId     String
  productId      String
  quantity       Decimal @db.Decimal(12, 4)
  unitPriceCents Int
  totalCents     Int

  adjustment SaleAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  saleItem   SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([saleItemId])
  @@map("sale_adjustment_items")
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  taxId          String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId])
  @@index([tenantId, normalizedName])
  @@index([tenantId, isActive])
  @@map("suppliers")
}

model Purchase {
  id                  String                @id @default(cuid())
  tenantId            String
  locationId          String
  supplierId          String
  status              PurchaseStatus        @default(DRAFT)
  documentNumber      String?
  purchasedAtUtc      DateTime              @default(now())
  receivedAtUtc       DateTime?
  createdByUserId     String
  receivedByUserId    String?
  cancelledByUserId   String?
  cancelledAtUtc      DateTime?
  subtotalCents       Int
  discountCents       Int                   @default(0)
  additionalCostCents Int                   @default(0)
  totalCents          Int
  paymentSource       PurchasePaymentSource @default(UNSPECIFIED)
  cashShiftId         String?
  cashMovementId      String?
  idempotencyKey      String?
  notes               String?
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser      User                @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  receivedByUser     User?               @relation("PurchaseReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser    User?               @relation("PurchaseCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  cashShift          CashShift?          @relation(fields: [cashShiftId], references: [id], onDelete: SetNull)
  items              PurchaseItem[]
  inventoryMovements InventoryMovement[]
  cashMovements      CashMovement[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchasedAtUtc])
  @@map("purchases")
}

model PurchaseItem {
  id                  String   @id @default(cuid())
  purchaseId          String
  productId           String
  productNameSnapshot String
  barcodeSnapshot     String?
  quantity            Int
  unitCostCents       Int
  lineTotalCents      Int
  createdAt           DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}
