datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  COUNT_CORRECTION
  SALE
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  CASH_IN
  CASH_OUT
  CLOSING
}

model User {
  id                 String              @id @default(cuid())
  email              String
  normalizedEmail    String              @unique
  name               String
  passwordHash       String
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        TenantMembership[]
  sessions           Session[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  openedShifts       CashShift[]         @relation("ShiftOpenedBy")
  closedShifts       CashShift[]         @relation("ShiftClosedBy")
  cashMovements      CashMovement[]

  @@map("users")
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  locations          Location[]
  memberships        TenantMembership[]
  sessions           Session[]
  categories         Category[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]

  @@map("tenants")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Location {
  id                 String              @id @default(cuid())
  tenantId           String
  name               String
  address            String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions           Session[]
  productLocations   ProductLocation[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  cashShifts         CashShift[]
  cashMovements      CashMovement[]

  @@index([tenantId])
  @@map("locations")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  locationId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("sessions")
}

model Category {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  normalizedName String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                 String              @id @default(cuid())
  tenantId           String
  categoryId         String?
  name               String
  normalizedName     String
  barcode            String?
  sku                String?
  salePriceCents     Int
  costPriceCents     Int?
  unit               String              @default("UNIT")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locations          ProductLocation[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, normalizedName])
  @@index([categoryId])
  @@map("products")
}

model ProductLocation {
  id            String    @id @default(cuid())
  productId     String
  locationId    String
  stockQuantity Decimal   @default(0) @db.Decimal(12, 4)
  minimumStock  Decimal   @default(0) @db.Decimal(12, 4)
  isAvailable   Boolean   @default(true)
  quickSlot     Int?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@unique([locationId, quickSlot])
  @@index([locationId])
  @@map("product_locations")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  locationId     String
  productId      String
  saleId         String?
  type           InventoryMovementType
  delta          Decimal               @db.Decimal(12, 4)
  previousStock  Decimal               @db.Decimal(12, 4)
  resultingStock Decimal               @db.Decimal(12, 4)
  reason         String
  userId         String
  createdAt      DateTime              @default(now())
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location              @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale           Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([tenantId, locationId, productId, createdAt])
  @@index([saleId])
  @@map("inventory_movements")
}

model Sale {
  id                 String              @id @default(cuid())
  tenantId           String
  locationId         String
  userId             String
  shiftId            String?
  idempotencyKey     String
  totalCents         Int
  status             String              @default("COMPLETED")
  createdAtUtc       DateTime
  persistedAt        DateTime            @default(now())
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  tenders            SaleTender[]
  inventoryMovements InventoryMovement[]
  cashMovements      CashMovement[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, createdAtUtc])
  @@index([shiftId])
  @@map("sales")
}

model SaleItem {
  id              String   @id @default(cuid())
  saleId          String
  productId       String
  name            String
  barcode         String?
  quantity        Decimal  @db.Decimal(12, 4)
  unitPriceCents  Int
  totalPriceCents Int
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SaleTender {
  id                  String  @id @default(cuid())
  saleId              String
  type                String
  amountCents         Int
  receivedAmountCents Int?
  changeAmountCents   Int?
  reference           String?
  sale                Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_tenders")
}

model CashShift {
  id                    String            @id @default(cuid())
  tenantId              String
  locationId            String
  openedByUserId        String
  closedByUserId        String?
  status                CashShiftStatus   @default(OPEN)
  openingAmountCents    Int
  expectedAmountCents   Int?
  countedAmountCents    Int?
  differenceAmountCents Int?
  openedAtUtc           DateTime
  closedAtUtc           DateTime?
  version               Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location              Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  openedByUser          User              @relation("ShiftOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedByUser          User?             @relation("ShiftClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements             CashMovement[]

  @@index([tenantId, locationId, status])
  @@index([tenantId, locationId, openedAtUtc])
  @@map("cash_shifts")
}

model CashMovement {
  id                String            @id @default(cuid())
  tenantId          String
  locationId        String
  shiftId           String
  createdByUserId   String
  type              CashMovementType
  amountCents       Int
  signedAmountCents Int
  reason            String?
  saleId            String?
  idempotencyKey    String
  createdAtUtc      DateTime          @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shift             CashShift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdByUser     User              @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  sale              Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, shiftId, createdAtUtc])
  @@index([shiftId])
  @@index([saleId])
  @@map("cash_movements")
}
