PORT=4000
NODE_ENV=development
# Local Docker Compose default. Staging must override this value through its secret manager.
DATABASE_URL=postgresql://pulso:pulso_dev_password@localhost:5432/pulso_dev?schema=public
# Non-secret staging identifier. Do not derive or store database credentials from it.
SUPABASE_PROJECT_REF=
TEST_DATABASE_URL=postgresql://pulso:pulso_test_password@localhost:5433/pulso_test?schema=public
SESSION_COOKIE_NAME=pulso_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:4173

# Development Seed Configuration (Never use in production)
DEV_SEED_EMAIL=operador@pulso.dev
DEV_SEED_PASSWORD=
DEV_SEED_NAME=Operador Mostrador
DEV_SEED_BUSINESS_NAME=Kiosco Demostración
DEV_SEED_LOCATION_NAME=Central
