# Pulso Environment Configuration

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL Development; keep this local default for Docker Compose)
DATABASE_URL=postgresql://pulso:pulso_dev_password@localhost:5432/pulso_dev?schema=public

# Supabase staging metadata. The project ref is not a credential; leave it empty in
# committed examples and set it in the staging environment.
SUPABASE_PROJECT_REF=

# For staging, replace DATABASE_URL through the deployment secret manager with the
# exact PostgreSQL connection URI shown by Supabase. Never commit its password.
# DIRECT_URL is used only by migrations and backup jobs. Do not expose it to the
# long-running API container when the hosting platform supports per-job secrets.
DIRECT_URL=

# Recovery jobs only. RESTORE_CONFIRM_DATABASE must exactly match the database name
# in RESTORE_DATABASE_URL; remote targets also require RESTORE_ALLOW_REMOTE=true.
RESTORE_DATABASE_URL=
RESTORE_CONFIRM_DATABASE=
RESTORE_ALLOW_REMOTE=false
BACKUP_FILE=backups/pulso-public.dump
ALLOW_BACKUP_OVERWRITE=false

# Database (PostgreSQL Test / Integration / E2E)
TEST_DATABASE_URL=postgresql://pulso:pulso_test_password@localhost:5433/pulso_test?schema=public

# Authentication & Sessions
SESSION_COOKIE_NAME=pulso_session
SESSION_TTL_HOURS=24
COOKIE_SECURE=false

# Required: stable high-entropy secret (at least 32 bytes) used to authenticate encrypted
# bulk-product-import previews. Generate and provision it through your secret manager.
PRODUCT_IMPORT_PREVIEW_SECRET=

# CORS & Trusted Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://127.0.0.1:3000,http://127.0.0.1:4173

# Development Seed Configuration (Never use in production)
DEV_SEED_EMAIL=operador@pulso.dev
DEV_SEED_PASSWORD=
DEV_SEED_NAME=Operador Mostrador
DEV_SEED_BUSINESS_NAME=Kiosco Demostración
DEV_SEED_LOCATION_NAME=Central
